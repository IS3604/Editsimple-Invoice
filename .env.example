# Copy to .env.local and fill in. These two values are PUBLIC by design
# (they ship in the browser bundle). Security comes from RLS, not secrecy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Only for GitHub Pages project sites (https://<user>.github.io/<repo>/).
# Leave empty for a custom domain.
VITE_BASE_PATH=/

# NEVER put the service-role key here or anywhere in the frontend.
# It belongs only in Supabase Edge Function secrets.
